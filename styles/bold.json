    "uppercase": false, "position": "bottom", "radius": 16, "shadow": "none", "border": "none"
  },
  "endCard": {
    "enabled": true, "background": "#0e0a1f", "color": "auto", "accent": "auto",
    "font": "Sofia Sans Condensed", "textFont": "Sofia Sans",
