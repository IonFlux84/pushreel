{
  "$schema": "../docs/style.schema.json",
  "name": "bold",
  "description": "Pushreel's own look and the default: heavy condensed type on an ink box, the stressed word on volt, a hard volt shadow on the cover.",
  "captions": {
    "font": "Sofia Sans Condensed", "weight": 800, "size": 74,
    "color": "#ffffff", "background": "#0e0a1f",
