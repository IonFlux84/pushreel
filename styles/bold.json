  },
  "cover": {
    "scene": null, "font": "Sofia Sans Condensed", "background": "#0e0a1f", "color": "#ffffff", "accent": "#d7ff1f",
    "uppercase": false, "radius": 24, "shadow": "hard", "logo": null
  },
  "motion": { "zoom": 1.4, "cursor": "arrow", "clickColor": "#ff2a8a", "scrollSpeed": 1 },
  "watermark": { "enabled": false, "logo": null, "corner": "top-right", "size": 120, "opacity": 0.9 },
